# ── Apollo ──────────────────────────────────────────────────────────────────
APOLLO_API_KEY=
APOLLO_MAX_PAGES=5
# Gate threshold — 0-12 scale (prestige dimension added Jun 2026). 8 recommended.
FIT_THRESHOLD=8

# ── Instantly ────────────────────────────────────────────────────────────────
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
# In Instantly, set the campaign subject to {{subject}} and body to {{body}}

# ── Clay ─────────────────────────────────────────────────────────────────────
# Inbound webhook URL — copy from Clay table → Sources → Webhook
CLAY_WEBHOOK_URL=
# Signing secret — value you set in Clay's outbound HTTP API column header
CLAY_WEBHOOK_SECRET=

# ── Anthropic (email composition) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Sender identity (used in compliance footer and system prompt) ─────────────
SENDER_NAME=
SENDER_TITLE=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
# Required — server.js refuses to start without it. The Lead Engine must send
# this as "Authorization: Bearer <key>" on every request except GET /health.
HADES_API_KEY=

# ── HubSpot (Phase 1 step 4 — add when token is available) ───────────────────
# HUBSPOT_PRIVATE_APP_TOKEN=

# ── Lead Engine Postgres (read leads / write back contact enrichment) ────────
DATABASE_URL=
